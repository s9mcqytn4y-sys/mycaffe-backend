# Optional settings for the demo stack (./scripts/dev.ps1 demo-up reads .env.demo if present).
# Copy to .env.demo (git-ignored). Only email settings belong here: database credentials of the
# demo volume are fixed in deploy/docker/docker-compose.demo.yml.
#
# Gmail for demo emails: enable 2-Step Verification on the Google account, then create an
# App Password at https://myaccount.google.com/apppasswords (16 characters, no spaces).
EMAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.account@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=your.account@gmail.com
EMAIL_FROM_NAME=MyCaffe Demo
# The public demo URL (changes when the Quick Tunnel restarts; see ./scripts/dev.ps1 demo-url).
APP_PUBLIC_URL=https://your-tunnel.trycloudflare.com
