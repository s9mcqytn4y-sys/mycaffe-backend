# ==============================================================================
# MyCaffe POS Platform - Demo / Staging Stack Configuration Template
# (./scripts/dev.ps1 demo-up reads .env.demo if present).
# Copy this file to .env.demo (git-ignored).
# DO NOT COMMIT LIVE SECRETS OR PASSWORDS.
# ==============================================================================

# 1. Email Delivery
# EMAIL_DRIVER: log (default, output to docker logs) or smtp (send actual emails)
EMAIL_DRIVER=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.account@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=your.account@gmail.com
EMAIL_FROM_NAME=MyCaffe Demo

# 2. Public URLs & Cloudflare Tunnel
# Changes when Quick Tunnel restarts; check with: ./scripts/dev.ps1 demo-url
APP_PUBLIC_URL=http://localhost:8088
DEFAULT_STORE_SLUG=central-cafe

# 3. Optional Cloudflare R2 Media Storage (Demo / Staging)
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mycaffe-media
R2_PRIVATE_BUCKET_NAME=mycaffe-private-media
R2_PUBLIC_URL=

# 4. Demo secrets (required; the stack refuses to start without them)
# JWT_SECRET_KEY: at least 32 random characters, e.g. `openssl rand -hex 32`.
# DEMO_OWNER_PIN / DEMO_STAFF_PIN replace the public seed PIN 482913 for every seeded owner and
# staff member. Two different 6-digit PINs; weak PINs (123456, 111111, birth years) are refused.
JWT_SECRET_KEY=
DEMO_OWNER_PIN=
DEMO_STAFF_PIN=

# 5. SMS one-time codes (docs/Setup/Sms.md). The demo runs APP_ENV=staging, where the log driver is
# refused; keep disabled until a provider driver and its API key exist.
SMS_DRIVER=disabled
