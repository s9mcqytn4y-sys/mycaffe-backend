# ==========================================
# 1. SERVER & APP CONFIGURATION
# ==========================================
APP_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3000

# ==========================================
# 2. SUPABASE & DATABASE CONFIGURATION
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Database Connection Strings & Credentials
# Dev/Staging: Supabase Connection String
# Production: Native PostgreSQL on VPS / Cloud
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
DB_HOST=db.your-project.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_db_password

# ==========================================
# 3. AUTHENTICATION & SECURITY (JWT)
# ==========================================
JWT_SECRET_KEY=your-jwt-secret-key-at-least-32-chars
JWT_EXPIRED_HOURS=24

# ==========================================
# 4. MIDTRANS PAYMENT GATEWAY
# ==========================================
# Dev/Staging: Sandbox (MIDTRANS_IS_PRODUCTION=false)
# Production: Production Key (MIDTRANS_IS_PRODUCTION=true)
MIDTRANS_MERCHANT_ID=your-merchant-id
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
MIDTRANS_IS_PRODUCTION=false

# ==========================================
# 5. SMTP EMAIL NOTIFICATION
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ==========================================
# 6. CRON JOB SECRET
# ==========================================
CRON_SECRET_TOKEN=your-cron-secret-token

# ==========================================
# 7. LOGGING & PERFORMANCE RUNTIME
# ==========================================
GIN_MODE=debug
LOG_LEVEL=info

# ==========================================
# 8. SENTRY ERROR MONITORING
# ==========================================
SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/projectId
SENTRY_ENVIRONMENT=development

# ==========================================
# 9. STORAGE CONFIGURATION (Cloudflare R2 / S3)
# ==========================================
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=kafe-senja-storage
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

