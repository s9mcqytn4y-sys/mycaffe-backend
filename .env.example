# ==============================================================================
# MyCaffe POS Platform - Environment Configuration Template
# All secrets and credentials in this file are placeholders.
# DO NOT COMMIT LIVE OR PRODUCTION CREDENTIALS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
APP_ENV=development
PORT=8080
FRONTEND_URL=https://pos.example.com
ALLOWED_ORIGINS=https://pos.example.com
# Comma-separated IPs/CIDRs of reverse proxies allowed to set X-Forwarded-For (e.g. the
# Nginx container network). Empty = trust no proxy; ClientIP() is then the TCP peer address.
TRUSTED_PROXIES=
# Docker Compose sets TRUSTED_PROXIES from the fixed edge subnet: EDGE_SUBNET (prod,
# default 172.30.0.0/24) and DEMO_EDGE_SUBNET (demo stack, default 172.29.10.0/24).
EDGE_SUBNET=172.30.0.0/24

# ------------------------------------------------------------------------------
# 2. Container Image Tags & TLS Bootstrap (Production Docker Compose / GHCR)
# ------------------------------------------------------------------------------
API_IMAGE_TAG=v1.0.0
WEB_IMAGE_TAG=v1.0.0
CERTBOT_EMAIL=ops@example.com
CERTBOT_DOMAINS=pos.example.com,api.example.com
FORCE_REPLACE_CERT=0

# ------------------------------------------------------------------------------
# 3. Database Configuration (Native PostgreSQL 18 - Triple-Role Separation)
# - DB_SUPERUSER (postgres)   : Container initdb bootstrap only
# - DB_MIGRATOR_USER          : Non-superuser schema owner & migration runner
# - DB_APP_USER (mycaffe_app) : Least-privilege runtime API role (NOBYPASSRLS, no DELETE on financial ledgers)
#
# Note: Host CLI commands use @localhost:5432 (DATABASE_URL / DATABASE_MIGRATION_URL),
# whereas Docker Compose services use @postgres:5432 (COMPOSE_DATABASE_URL / COMPOSE_DATABASE_MIGRATION_URL)
# over the isolated mycaffe-data internal bridge network.
# The migrate service uses LoadMigrateConfig() and only requires APP_ENV,
# COMPOSE_DATABASE_MIGRATION_URL, DB_APP_USER, and DB_APP_PASSWORD.
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mycaffe_dev

DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=super_password_placeholder

DB_MIGRATOR_USER=mycaffe_migrator
DB_MIGRATOR_PASSWORD=migrator_password_placeholder

DB_USER=mycaffe_app
DB_PASSWORD=app_password_placeholder
DB_APP_USER=mycaffe_app
DB_APP_PASSWORD=app_password_placeholder

DATABASE_URL=postgres://mycaffe_app:app_password_placeholder@localhost:5432/mycaffe_dev?sslmode=disable
DATABASE_MIGRATION_URL=postgres://mycaffe_migrator:migrator_password_placeholder@localhost:5432/mycaffe_dev?sslmode=disable

COMPOSE_DATABASE_URL=postgres://mycaffe_app:app_password_placeholder@postgres:5432/mycaffe_dev?sslmode=disable
COMPOSE_DATABASE_MIGRATION_URL=postgres://mycaffe_migrator:migrator_password_placeholder@postgres:5432/mycaffe_dev?sslmode=disable

# ------------------------------------------------------------------------------
# 4. Authentication & Security (Stateless JWT HMAC-SHA256)
# Minimum 32 characters high-entropy string
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-very-long-random-secret-key-min-32-chars
JWT_EXPIRED_HOURS=24
# Staff sessions (ADR-003 D3/D4, owner decision O3). JWT_EXPIRED_HOURS is not used for staff
# access tokens. Production fails closed above 1h access / 24h refresh.
STAFF_ACCESS_TOKEN_TTL=15m
STAFF_REFRESH_TOKEN_TTL=12h
STAFF_SESSION_IDLE_TIMEOUT=2h
STAFF_MAX_SESSIONS_PER_USER=3
STAFF_PIN_MAX_FAILURES=5
STAFF_PIN_LOCKOUT=15m

# ------------------------------------------------------------------------------
# Email (owner decision E5). EMAIL_DRIVER=log prints emails to the server log (dev/test
# only, rejected in production). EMAIL_DRIVER=smtp delivers via SMTP:
#   Dev/demo Gmail : SMTP_HOST=smtp.gmail.com SMTP_PORT=587 (STARTTLS), SMTP_USERNAME=you@gmail.com,
#                    SMTP_PASSWORD=<16-char Google App Password, requires 2-Step Verification>
#   Production     : SMTP_HOST=smtp.hostinger.com SMTP_PORT=465 (implicit TLS), mailbox address + password
# APP_PUBLIC_URL is the POS frontend origin used for activation / PIN-reset links.
# ------------------------------------------------------------------------------
EMAIL_DRIVER=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS_MODE=
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=smtp_password_placeholder
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=MyCaffe
APP_PUBLIC_URL=http://localhost:3000

# Single-cafe deployments (owner decision Q3): staff log in with email + PIN only; the store
# code defaults to this slug. Leave empty when running several branches.
DEFAULT_STORE_SLUG=central-cafe

# ------------------------------------------------------------------------------
# 5. Midtrans Payment Gateway (Core API Direct Integration)
# Development: Sandbox (MIDTRANS_IS_PRODUCTION=false)
# Production: Live Credentials (MIDTRANS_IS_PRODUCTION=true)
# ------------------------------------------------------------------------------
MIDTRANS_MERCHANT_ID=G000000000
MIDTRANS_SERVER_KEY=Mid-server-production-placeholder
MIDTRANS_CLIENT_KEY=Mid-client-production-placeholder
MIDTRANS_IS_PRODUCTION=false

# ------------------------------------------------------------------------------
# 6. Cloudflare R2 Storage - Dual Bucket Architecture
# 6A. Public Product & Store Media Bucket (mycaffe-media)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-media-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-media-secret-access-key
R2_BUCKET_NAME=mycaffe-media
R2_PUBLIC_URL=https://cdn.example.com

# ------------------------------------------------------------------------------
# 6B. Private Offsite Encrypted Database Backup Bucket (mycaffe-backups)
# Used exclusively by scripts/backup/backup_to_r2.sh & restore_from_r2.sh
# ------------------------------------------------------------------------------
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_BACKUP_BUCKET=mycaffe-backups
AWS_ACCESS_KEY_ID=your-r2-backup-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-backup-secret-access-key
BACKUP_ENCRYPTION_PASSPHRASE=your-strong-gpg-backup-passphrase

# ------------------------------------------------------------------------------
# 8. Sentry Error Monitoring & Operational Secrets
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/projectId
SENTRY_ENVIRONMENT=development
CRON_SECRET_TOKEN=your-internal-cron-trigger-secret-token
