# ==============================================================================
# MyCaffe POS Platform — Environment Configuration Template
# All secrets and credentials in this file are placeholders.
# DO NOT COMMIT LIVE OR PRODUCTION CREDENTIALS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
APP_ENV=development
PORT=8080
FRONTEND_URL=https://pos.example.com
ALLOWED_ORIGINS=https://pos.example.com

# ------------------------------------------------------------------------------
# 2. Container Image Tags (Production Docker Compose / GHCR)
# ------------------------------------------------------------------------------
API_IMAGE_TAG=v1.0.0
WEB_IMAGE_TAG=v1.0.0

# ------------------------------------------------------------------------------
# 3. Database Configuration (Native PostgreSQL 18 — Dual Role Separation)
# Runtime API uses least-privilege mycaffe_app (NOBYPASSRLS).
# Schema Migrator CLI uses owner role mycaffe_migrator.
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://mycaffe_app:app_password_placeholder@localhost:5432/mycaffe_dev?sslmode=disable
DATABASE_MIGRATION_URL=postgres://mycaffe_migrator:migrator_password_placeholder@localhost:5432/mycaffe_dev?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mycaffe_dev
DB_USER=mycaffe_app
DB_PASSWORD=app_password_placeholder
DB_MIGRATOR_USER=mycaffe_migrator
DB_MIGRATOR_PASSWORD=migrator_password_placeholder

# ------------------------------------------------------------------------------
# 4. Authentication & Security (Stateless JWT HMAC-SHA256)
# Minimum 32 characters high-entropy string
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-very-long-random-secret-key-min-32-chars
JWT_EXPIRED_HOURS=24

# ------------------------------------------------------------------------------
# 5. Midtrans Payment Gateway (Core API Direct Integration)
# Development: Sandbox (MIDTRANS_IS_PRODUCTION=false)
# Production: Live Credentials (MIDTRANS_IS_PRODUCTION=true)
# ------------------------------------------------------------------------------
MIDTRANS_MERCHANT_ID=G000000000
MIDTRANS_SERVER_KEY=Mid-server-production-placeholder
MIDTRANS_CLIENT_KEY=Mid-client-production-placeholder
MIDTRANS_IS_PRODUCTION=false

# ------------------------------------------------------------------------------
# 6. Cloudflare R2 Storage — Dual Bucket Architecture
# 6A. Public Product & Store Media Bucket (mycaffe-media)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-media-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-media-secret-access-key
R2_BUCKET_NAME=mycaffe-media
R2_PUBLIC_URL=https://cdn.example.com

# ------------------------------------------------------------------------------
# 6B. Private Offsite Encrypted Database Backup Bucket (mycaffe-backups)
# Used exclusively by scripts/backup/backup_to_r2.sh with GPG AES256+SHA512
# ------------------------------------------------------------------------------
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_BACKUP_BUCKET=mycaffe-backups
AWS_ACCESS_KEY_ID=your-r2-backup-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-backup-secret-access-key
BACKUP_ENCRYPTION_PASSPHRASE=your-strong-gpg-backup-passphrase

# ------------------------------------------------------------------------------
# 7. SMTP Notification (Optional / Transactional Receipts)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-char-app-password

# ------------------------------------------------------------------------------
# 8. Sentry Error Monitoring & Operational Secrets
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/projectId
SENTRY_ENVIRONMENT=development
CRON_SECRET_TOKEN=your-internal-cron-trigger-secret-token
