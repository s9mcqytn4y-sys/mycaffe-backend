# ==============================================================================
# MyCaffe Core POS - Environment Configuration Template (.env.example)
# ==============================================================================
# WARNING: Never commit a real .env file containing credentials to version control.
# Copy this file to .env for local development:
#   cp .env.example .env
# ==============================================================================

# --- Application & Server ---
APP_ENV=development
APP_PORT=8080
METRICS_PORT=9091
APP_PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_PROXIES=127.0.0.1,::1
LOG_LEVEL=debug

# --- Database (PostgreSQL 18 - Local Docker Compose) ---
# Production deployment runs PostgreSQL 18 in Docker on the same Hostinger VPS (ADR-002).
# Local development uses the postgres container in deploy/docker/docker-compose.yml.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=mycaffe_app
DB_PASSWORD=mycaffe_app_dev_password
DB_NAME=mycaffe_dev
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=15m

# Role password variables used by deploy/docker/init-roles.sh on fresh container init
DB_MIGRATOR_PASSWORD=mycaffe_migrator_dev_password
DB_APP_PASSWORD=mycaffe_app_dev_password

# Explicit DSNs for Go runtime (mycaffe_app with NOBYPASSRLS) and migration CLI (mycaffe_migrator)
DATABASE_URL=postgres://mycaffe_app:mycaffe_app_dev_password@127.0.0.1:5432/mycaffe_dev?sslmode=disable
DATABASE_MIGRATOR_URL=postgres://mycaffe_migrator:mycaffe_migrator_dev_password@127.0.0.1:5432/mycaffe_dev?sslmode=disable

# --- Authentication & Security ---
# Generate a strong secret with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_at_least_32_byte_random_hex_secret_in_production
JWT_EXPIRY_HOURS=12
BCRYPT_COST=12

# --- Midtrans Payment Gateway (Core API Direct Integration - No Snap) ---
# Always use Sandbox (MIDTRANS_IS_PRODUCTION=false) in development and demo/staging.
# Switch to MIDTRANS_IS_PRODUCTION=true ONLY in production after Midtrans business review passes.
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-replace_with_sandbox_server_key
MIDTRANS_CLIENT_KEY=SB-Mid-client-replace_with_sandbox_client_key
MIDTRANS_MERCHANT_ID=G000000000

# --- Cloudflare R2 Object Storage (Dual-Bucket Architecture) ---
# Bucket 1: mycaffe-media (public CDN product & store branding images, e.g., https://cdn.abbdullaziz.online)
# Bucket 2: mycaffe-private-media / mycaffe-backups (private receipts & encrypted pg_dump backups)
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_ACCESS_KEY_ID=replace_with_r2_media_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_r2_media_secret_access_key
R2_BUCKET_NAME=mycaffe-media
R2_PRIVATE_BUCKET_NAME=mycaffe-private-media
R2_PUBLIC_URL=https://cdn.abbdullaziz.online

# --- Encrypted Database Backup Target (Used by scripts/backup-postgres.sh) ---
R2_BACKUP_BUCKET_NAME=mycaffe-backups
R2_BACKUP_ACCESS_KEY_ID=replace_with_r2_backup_access_key_id
R2_BACKUP_SECRET_ACCESS_KEY=replace_with_r2_backup_secret_access_key
BACKUP_GPG_PASSPHRASE=replace_with_strong_random_gpg_passphrase

# --- Transactional Email (Staff PIN Reset & Digital Receipts) ---
# Supported drivers: log (development only), smtp, disabled
# Domain email routing uses Cloudflare Email Routing (*@abbdullaziz.online) + SMTP relay.
EMAIL_DRIVER=log
EMAIL_FROM_ADDRESS=noreply@abbdullaziz.online
EMAIL_FROM_NAME=MyCaffe POS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password

# --- SMS / OTP Delivery (Staff Forgot-PIN SMS & Customer Phone Verification) ---
# Supported drivers:
#   - log      : Structured stdout log (development only; blocked in staging/production)
#   - email    : Free SMS-to-Email SMTP bridge (delivers SMS OTPs to SMS_EMAIL_TO via active EMAIL_DRIVER=smtp)
#   - webhook  : HTTP POST JSON {"to","body"} to SMS_WEBHOOK_URL (Telegram/WhatsApp/Custom Gateway)
#   - disabled : Explicit no-op
SMS_DRIVER=log
SMS_EMAIL_TO=owner@abbdullaziz.online
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# --- Error Tracking & Observability (Sentry Free Plan) ---
# Leave SENTRY_DSN empty to disable Sentry reporting locally.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
