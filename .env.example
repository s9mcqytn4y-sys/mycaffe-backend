# ==============================================================================
# MyCaffe POS Platform — Environment Configuration Template
# All secrets and credentials in this file are placeholders.
# DO NOT COMMIT LIVE OR PRODUCTION CREDENTIALS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
APP_ENV=development
PORT=8080
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. Database Configuration (Native PostgreSQL 18)
# Hostinger VPS or Local Docker: postgres://mycaffe_user:password@localhost:5432/mycaffe_dev?sslmode=disable
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://mycaffe_user:password@localhost:5432/mycaffe_dev?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mycaffe_dev
DB_USER=mycaffe_user
DB_PASSWORD=your_secure_db_password

# ------------------------------------------------------------------------------
# 3. Authentication & Security (Stateless JWT HMAC-SHA256)
# Minimum 32 characters high-entropy string
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-very-long-random-secret-key-min-32-chars
JWT_EXPIRED_HOURS=24

# ------------------------------------------------------------------------------
# 4. Midtrans Payment Gateway
# Development: Sandbox (MIDTRANS_IS_PRODUCTION=false)
# Production: Live Credentials (MIDTRANS_IS_PRODUCTION=true)
# ------------------------------------------------------------------------------
MIDTRANS_MERCHANT_ID=your-merchant-id
MIDTRANS_SERVER_KEY=SB-Mid-server-placeholder
MIDTRANS_CLIENT_KEY=SB-Mid-client-placeholder
MIDTRANS_IS_PRODUCTION=false

# ------------------------------------------------------------------------------
# 5. SMTP Notification (Optional / Transactional Receipts)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-char-app-password

# ------------------------------------------------------------------------------
# 6. Sentry Error Monitoring (Developer Free Tier)
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/projectId
SENTRY_ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 7. Offsite Backup (Cloudflare R2 Free Tier / S3-compatible)
# Used strictly for offsite encrypted pg_dump disaster recovery
# ------------------------------------------------------------------------------
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=mycaffe-backups
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
BACKUP_ENCRYPTION_PASSPHRASE=your-strong-backup-passphrase

# ------------------------------------------------------------------------------
# 8. Operational Secrets
# ------------------------------------------------------------------------------
CRON_SECRET_TOKEN=your-internal-cron-trigger-secret-token
